# Default discovery should find reviewed model knowledge before audit payloads.
# Use a linked file directly or rg --no-ignore <pattern> <specific-directory> to inspect evidence.
knowledge/top_model/*/data/
knowledge/top_model/*/evidence/
knowledge/top_model/*/kernel_sources/
knowledge/top_model/*/gpu_validation/*.json
knowledge/top_model/*/gpu_validation/*.txt
knowledge/top_model/*/gpu_validation/*.sh
# Historical operator overviews remain linked from the current operator entry.
knowledge/operator/*/geak_reference.md
