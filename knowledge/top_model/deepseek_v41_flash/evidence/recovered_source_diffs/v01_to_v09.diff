+        "K_NORM_ROPE_MXFP4_CACHE: k=%s kv_cache=%s compress_ratio=%d shuffle=%s",
+        tuple(k.shape),
+        tuple(kv_cache.shape),
+        compress_ratio,
+        shuffle,
+    )
