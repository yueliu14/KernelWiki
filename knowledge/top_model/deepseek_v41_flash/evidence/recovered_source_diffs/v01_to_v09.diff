+        tag = (ep << 1) + 2
+        par = fx.Int64(ep & 1) * fx.Int64(half)
+        bases = [b + par for b in peer_bases(peers, tp)]
+        own = sym + par
+        bargs = {
+            "q": q,
+            "swa": swa,
