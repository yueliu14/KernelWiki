+            swa_lens,
+            comp_block,
+            comp_bt,
+            bt_stride,
+            topk,
+            t2r,
+            kt,
+            klen,
+            normed_out,
+            qr_out,
+            scratch,
+            epoch,
+            tl,
+        ).launch(grid=(BLOCKS,), block=(THREADS,), stream=stream)
+
