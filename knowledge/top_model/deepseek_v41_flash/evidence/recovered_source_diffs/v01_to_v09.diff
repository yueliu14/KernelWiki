+_k_norm_rope_mxfp4_cache_repr = make_kernel_repr(
+    "_k_norm_rope_mxfp4_cache_kernel",
+    ["HEAD_SIZE", "ROPE_DIM", "COMPRESS_RATIO", "PRESHUFFLE", "N_PER_TILE"],
+)
+
