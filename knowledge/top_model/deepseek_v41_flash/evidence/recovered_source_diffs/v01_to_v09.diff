+class _MHCHeadDSV4(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, residual, fn, scale, base, eps, pre_eps, config):
+        ctx.save_for_backward(residual, fn, scale, base)
+        ctx.params = (eps, pre_eps)
