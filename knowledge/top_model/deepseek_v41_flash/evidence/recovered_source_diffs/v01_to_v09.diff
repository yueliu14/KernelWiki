+    cs_base = cos_sin_ptr + group_pos * cos_sin_stride
+    cos = tl.load(cs_base + cs_idx, mask=is_rope, other=1.0)
+    sin = tl.load(cs_base + HALF_ROPE + cs_idx, mask=is_rope, other=0.0)
