+        (1024, _tiled(128, 128, 128, 1, True, 8, 2, 32, 1)),
+        (2048, _tiled(128, 128, 128, 1, True, 4, 2, 32, 0)),
+        (8192, _tiled(128, 256, 128, 1, True, 2, 2, 32, 0)),
