+    BLOCKS,
+    THREADS,
+    WAVES,
+    first_task,
+    pair_layout,
+)
+from vllm.models.deepseek_v41.amd.mono.common.sync import preg, publish, sreg
+from vllm.models.deepseek_v41.amd.mono.stages import moe_plan as mplan
