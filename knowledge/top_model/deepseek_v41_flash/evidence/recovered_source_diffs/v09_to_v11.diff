+    hidden_states,
+    gathered,
+    gathered_f32,
+    token_mask,
+    output,
+    num_tokens,
+    hidden_stride_t,
+    hidden_stride_h,
+    hidden_stride_d,
+    gathered_stride_t,
+    gathered_f32_stride_t,
+    mask_stride,
+    output_stride_t,
+    output_stride_h,
+    output_stride_d,
+    eps,
+    clamp_value,
+    DIM: tl.constexpr,
+    WIDTH: tl.constexpr,
+    TP_SIZE: tl.constexpr,
+    HC_MULT: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+    HAS_MASK: tl.constexpr,
