+        HC=n,
+        N_OUT=N_total,
+        N_PAD=N_PAD,
+        BLOCK_M=block_m,
+        KS=KS,
+        K_LOOP=k_loop,
+        SPLIT_K=split_k,
+        NUM_STAGES=num_stages,
+        RES_SHUFFLED=res_shuffled,
+        W_PRESHUFFLED=w_preshuffled,
+        WMMA=wmma,
+        OP_A=op_a,
+        OP_B=op_b,
+        SMEM_X=smem_x,
+        SMEM_RES=smem_res,
+        SMEM_FN=smem_fn,
+        SMEM_NRES=smem_nres,
+        SMEM_RED=smem_red,
+        SMEM_RED2=smem_red2,
+        num_warps=split_warps,
+        enable_fp_fusion=True,
+    )
+
+    # ---- launch 2: pre reduce/apply (HIP mhc_pre_big_fuse / _rmsnorm) ----
