+            f"mhc_fused_post_pre_delayed: {name} has dtype {t.dtype}, expected {dtype}"
+        )
+    if tuple(t.shape) not in shapes:
+        raise ValueError(
+            f"mhc_fused_post_pre_delayed: {name} has shape {tuple(t.shape)}, expected "
+            + " or ".join(str(s) for s in shapes)
+        )
