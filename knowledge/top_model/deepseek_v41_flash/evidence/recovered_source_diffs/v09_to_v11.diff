+        rows = n if capturing else MHC_SEAM_MAX_T_PER_LAUNCH
+        buf = torch.zeros(rows, hc_mult, dtype=dtypes.fp32, device=device)
+        buf[:, 0] = 1.0
+        if capturing:
+            return buf
