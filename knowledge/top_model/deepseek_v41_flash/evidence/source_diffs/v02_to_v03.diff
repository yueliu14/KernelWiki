+    # a finite scale.
+    amax = tl.maximum(tl.max(tl.abs(tiles), 1), 1e-4)
+    exponent = tl.ceil(tl.log2(amax * (1.0 / fp8_max)))
+    scaled = tl.clamp(
+        tiles * tl.reshape(tl.exp2(-exponent), (scale_dim, 1)), -fp8_max, fp8_max
+    )
