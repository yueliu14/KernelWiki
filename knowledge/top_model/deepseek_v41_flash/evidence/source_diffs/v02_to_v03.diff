+        _fp32x2_to_fp4x2(lo, hi),
+    )
+    scales = page + CACHE_BLOCK * 256 + (slot % CACHE_BLOCK) * 32
+    tl.store(scales + tl.arange(0, 32), scale.to(tl.uint8, bitcast=True))
