+    if work <= 128:
+        return 32, 16, 1024, 2, 3
+    if work <= 256:
+        return 32, 32, 512, 2, 3
+    if work <= 512:
+        return 64, 32, 512, 2, 3
+    if work <= 1024:
+        return 64, 64, 512, 4, 2
+    if work <= 2048:
