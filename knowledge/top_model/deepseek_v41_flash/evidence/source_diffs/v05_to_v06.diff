+                # Dropping the owner runs the finalizer; the mapping then unmaps.
+                del tensor, owner, mapping
+                raise RuntimeError(
+                    "Engram shared-memory initialization failed: " + failures
+                )
+            assert tensor is not None
+            return tensor
