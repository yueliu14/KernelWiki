+    nb = triton.cdiv(vocab, BLOCK)
+    nb2 = triton.next_power_of_2(nb)
+    logger.info_once(
+        "DSpark fused Markov sampling: %d steps, vocabulary %d, rank %d, %d blocks",
+        n_spec, vocab, rank, nb,
+    )  # fmt: skip
