+    ragged_ptr,
+    indptr_ptr,
+    query_start_loc_ptr,
+    seq_lens_ptr,
+    token_to_req_ptr,
+    block_table_ptr,
+    block_table_stride,
+    replay_start_ptr,
+    num_tokens,
+    window_size,
+    block_size,
+    WIDTH: tl.constexpr,
+    BLOCK: tl.constexpr,
+    ROWS: tl.constexpr,
+    TAIL: tl.constexpr,
