+        q_fp8.view(rows, *q_fp8.shape[2:]),
+        kv_cache,
+        weights[:rows],
+        seq_lens,
+        next_n,
+        block_table,
+        candidates,
+        block_size,
+        compact_logits,
+        compact_ids,
+    )
