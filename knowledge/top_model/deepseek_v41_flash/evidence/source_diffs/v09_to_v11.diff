+    rows = logits.shape[0]
+    taken = (
+        logits.stride(1) == 1
+        and ends.dtype == torch.int32
+        and ends.is_contiguous()
+        and candidates.dtype == torch.int32
+        and candidates.stride(1) == 1
+        and candidates.shape[0] >= rows
+        and block_size >= 1
+    )
+    if taken:
