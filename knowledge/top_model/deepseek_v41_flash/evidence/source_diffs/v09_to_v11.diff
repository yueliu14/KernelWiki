+    slot_ptr,
+    pos_ptr,
+    swa_lens_ptr,
+    swa_idx_ptr,
+    topk_ptr,
+    t2r_ptr,
+    bt_ptr,
+    bt_stride,
+    comp_block,
+    kt_ptr,
+    klen_ptr,
