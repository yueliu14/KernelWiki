+        cache_v,
+        qo,
+        ko,
+        vo,
+        go,
+        k_scale,
+        v_scale,
+        m,
+        2304,
+        8,
+        16,
+        2,
+        64,
+        float(eps),
+        float(q_scale),
+        cos_sin is not None,
+        mapping is not None,
+        cos_sin.stride(0) if cos_sin is not None else 64,
+        num_warps=1,
+    )
+    return qo, ko, vo, go
