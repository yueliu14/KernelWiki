+    return out
+
+
+def use_balanced_full(num_seqs: int, kv_heads: int) -> bool:
+    # TEP8 (2 KV heads), MI355X, 8 x 20-150K contexts: the even split costs 80-96 us at 6-8 requests (two waves a CU)
+    # against 60-62 for the work list, which stays flat; up to 5 requests the even split is the faster one (39-55 us).
+    return num_seqs >= (4 if kv_heads >= 4 else 6)
+
