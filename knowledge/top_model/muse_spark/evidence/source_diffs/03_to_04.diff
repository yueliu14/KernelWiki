+    return _launch_reduce(
+        (part, maxi, den, (seg_start, seg_count), v_descale),
+        out,
+        out.stride(0),
+        out.stride(1),
+        False,
+    )
+
+
+def swa_verify_flydsl(
+    q,
+    k,
+    v,
+    out,
+    seqused_k,
+    block_table,
+    softmax_scale,
