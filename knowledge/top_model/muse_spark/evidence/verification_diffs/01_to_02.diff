--- v1/sgl-workspace/sglang/python/sglang/srt/rocm_muse_spark/attention_kv_write.py
+++ v2/sgl-workspace/sglang/python/sglang/srt/rocm_muse_spark/attention_kv_write.py
@@ -0,0 +1,200 @@
+"""Fused QK norm / RoPE / FP8 KV-cache write for Muse Spark attention on ROCm (decode and target verify).
+
+``MuseSpark1xAttention`` hands K/V to the cache itself when one of these kernels applies and then calls the
+attention layer with ``save_kv_cache=False``, the usual SGLang pattern for producers that fuse the cache store
+(bailing_moe, gemma4):
+
+* ``qkv_proj_norm_rope_kv_write`` (``SGLANG_MUSE_FUSED_QKV_CACHE``): up to 32 rows, the QKV + output-gate
+  projection's split-K partials feed the QK-norm / RoPE / cache-store epilogue directly.
+* ``qk_norm_rope_kv_write`` (``SGLANG_MUSE_QK_ROPE_CACHE``): up to 64 rows, from the projected Q/K/V.
+
+Both write exactly where and what the backend's own store would (FP8 with the layer's per-tensor scales, through
+the full -> SWA slot mapping on sliding layers), so they only engage when the backend reads K/V from the
+16-token NHD FP8 pages of the aiter unified-attention backend.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import NamedTuple
+
+import torch
+
+from sglang.kernels.ops.attention.qk_norm_rope_cache import (
+    qk_norm_rope_cache,
+    qkv_proj_qk_norm_rope_cache,
+)
+from sglang.srt.environ import envs
+from sglang.srt.layers.attention.aiter_backend import AiterAttnBackend
+from sglang.srt.model_executor.forward_batch_info import ForwardBatch
+from sglang.srt.model_executor.forward_context import get_attn_backend
+
+logger = logging.getLogger(__name__)
+
+QK_ROPE_CACHE = envs.SGLANG_MUSE_QK_ROPE_CACHE.get()
+FUSED_QKV_CACHE = envs.SGLANG_MUSE_FUSED_QKV_CACHE.get()
+_logged: set = set()
+
+
+class _KVWriteTarget(NamedTuple):
+    k_cache: torch.Tensor
+    v_cache: torch.Tensor
+    locations: torch.Tensor
+    swa_mapping: torch.Tensor | None
+    k_scale: torch.Tensor
+    v_scale: torch.Tensor
+    cos_sin: torch.Tensor | None
+
+
+def _attention_shape_ok(attention, forward_batch: ForwardBatch) -> bool:
+    return (
+        attention.head_dim == 64
+        and attention.num_heads == 16
+        and attention.num_kv_heads == 2
+        and attention.use_qk_norm
+        and not attention.use_attn_temperature_tuning
+        and (
+            forward_batch.forward_mode.is_decode()
+            or forward_batch.forward_mode.is_target_verify()
+        )
+        and not forward_batch.attn_attend_prefix_cache
+        and forward_batch.dcp_kv_mask is None
+    )
+
+
+def _kv_write_target(attention, forward_batch: ForwardBatch) -> _KVWriteTarget | None:
+    """Where the backend reads this layer's K/V from, if the fused kernels can write it there."""
+    backend = get_attn_backend()
+    layer = attention.attn
+    if not (
+        isinstance(backend, AiterAttnBackend)
+        and not backend.use_mla
+        and backend.page_size == 16
+        and not backend.kv_cache_is_vectorized_5d
+        and backend.use_triton_unified_attention
+        and not layer.is_cross_attention
+        and backend.kv_cache_dtype == torch.float8_e4m3fn
+    ):
+        return None
+    rope = attention.rotary_emb
+    if rope is not None and not (
+        type(rope).__name__ == "RotaryEmbedding"
+        and not rope.is_neox_style
+        and rope.rotary_dim == 64
+        and rope.position_start == 0
+        and rope.cos_sin_cache.dtype == torch.float32
+    ):
+        return None
+    k_cache, v_cache = backend.token_to_kv_pool.get_kv_buffer(layer.layer_id)
+    if not (
+        k_cache.dtype == v_cache.dtype == torch.float8_e4m3fn
+        and k_cache.is_contiguous()
+        and v_cache.is_contiguous()
+    ):
+        return None
+    # The same per-tensor scales the backend's own store would divide by.
+    k_scale = layer.k_scale if layer.k_scale is not None else backend.k_scale
+    v_scale = layer.v_scale if layer.v_scale is not None else backend.v_scale
+    if not (
+        k_scale is not None
+        and v_scale is not None
+        and k_scale.numel() == v_scale.numel() == 1
+    ):
+        return None
+    swa_mapping = (
+        backend.swa_kv_pool.full_to_swa_index_mapping
+        if backend.use_sliding_window_kv_pool and layer.sliding_window_size > 0
+        else None
+    )
+    return _KVWriteTarget(
+        k_cache,
+        v_cache,
+        forward_batch.out_cache_loc,
+        swa_mapping,
+        k_scale,
+        v_scale,
+        rope.cos_sin_cache if rope is not None else None,
+    )
+
+
+def _note(name: str, rows: int) -> None:
+    if name not in _logged:
+        _logged.add(name)
+        logger.info("Muse fast path: %s, rows=%d", name, rows)
+
+
+def qkv_proj_norm_rope_kv_write(
+    attention, positions: torch.Tensor, x: torch.Tensor, forward_batch: ForwardBatch
+):
+    """(q, k, v, o_gate) with K/V already in the cache, or None when the fused projection does not apply."""
+    projection = attention.qkv_proj
+    if not (
+        x.ndim == 2
+        and 0 < x.shape[0] <= 32
+        and x.shape[1] == 8192
+        and x.dtype == torch.bfloat16
+        and x.is_contiguous()
+        and projection.weight.shape == (2304, 8192)
+        and projection.weight.dtype == torch.bfloat16
+        and projection.weight.is_contiguous()
+        and projection.bias is None
+        and not projection.gather_output
+        and attention.use_o_gate
+        and _attention_shape_ok(attention, forward_batch)
+    ):
+        return None
+    target = _kv_write_target(attention, forward_batch)
+    if target is None:
+        return None
+    _note("QKV projection/QK norm/RoPE/FP8 cache", x.shape[0])
+    return qkv_proj_qk_norm_rope_cache(
+        x,
+        projection.weight,
+        positions,
+        target.cos_sin,
+        target.k_cache,
+        target.v_cache,
+        target.locations,
+        target.swa_mapping,
+        attention.norm_eps,
+        attention.scale_query_by,
+        target.k_scale,
+        target.v_scale,
+    )
+
+
+def qk_norm_rope_kv_write(
+    attention,
+    positions: torch.Tensor,
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    forward_batch: ForwardBatch,
+):
+    """(q, k) normalized and rotated with K/V already in the cache, or None when the kernel does not apply."""
+    if not (
+        0 < q.shape[0] <= 64
+        and q.dtype == k.dtype == v.dtype == torch.bfloat16
+        and q.stride(1) == k.stride(1) == v.stride(1) == 1
+        and _attention_shape_ok(attention, forward_batch)
+    ):
+        return None
+    target = _kv_write_target(attention, forward_batch)
+    if target is None:
+        return None
+    _note("QK norm/RoPE/FP8 cache", q.shape[0])
+    return qk_norm_rope_cache(
+        q,
+        k,
+        v,
+        positions,
+        target.cos_sin,
+        target.k_cache,
+        target.v_cache,
+        target.locations,
+        target.swa_mapping,
+        attention.norm_eps,
+        attention.scale_query_by,
+        target.k_scale,
+        target.v_scale,
+    )
--- v1/sgl-workspace/sglang/python/sglang/srt/rocm_muse_spark/router_pooler.py
+++ v2/sgl-workspace/sglang/python/sglang/srt/rocm_muse_spark/router_pooler.py
@@ -0,0 +1,127 @@
+"""Muse Spark MoE routing front on ROCm: one kernel sequence for the FP32 router and the BF16 pooler.
+
+At decode / verify widths (up to 64 rows) the router logits, the sigmoid top-8 routing, the pooler projection
+and the pre-expert RMSNorm share one epilogue (``kernels/ops/moe/router_pooler_topk``) instead of separate
+router GEMM, routing, pooler GEMM and norm launches (``SGLANG_MUSE_SHARED_ROUTER_POOLER``). Verify batches of
+8 / 16 / 24 rows run the router and the pooler as one GEMM over a packed weight prepared after loading
+(``SGLANG_MUSE_JOINT_ROUTER_POOLER``).
+"""
+
+from __future__ import annotations
+
+import logging
+
+import torch
+
+from sglang.kernels.ops.moe.router_pooler_topk import (
+    joint_router_pooler_topk,
+    pack_joint_router_pooler_weight,
+    router_pooler_topk,
+)
+from sglang.srt.environ import envs
+
+logger = logging.getLogger(__name__)
+
+SHARED_ROUTER_POOLER = envs.SGLANG_MUSE_SHARED_ROUTER_POOLER.get()
+JOINT_ROUTER_POOLER = envs.SGLANG_MUSE_JOINT_ROUTER_POOLER.get()
+_JOINT_ROWS = (8, 16, 24)
+_logged: set = set()
+
+
+def can_share_router_pooler(moe, x: torch.Tensor) -> bool:
+    """The Muse Spark TP8 routing front: 8192 hidden, 256 experts top-8 sigmoid, 4096-wide pooler + norm."""
+    op = moe._routing_op()
+    return (
+        0 < x.shape[0] <= 64
+        and x.shape[1] == 8192
+        and x.is_contiguous()
+        and x.dtype == torch.bfloat16
+        and moe.router_in_fp32
+        and moe.router.weight.dtype == torch.float32
+        and moe.router.weight.shape == (8192, 256)
+        and moe.router.weight.is_contiguous()
+        and moe.top_k == 8
+        and moe.num_experts == 256
+        and moe.pre_expert_proj is not None
+        and moe.pre_expert_proj.bias is None
+        and moe.pre_expert_proj.weight.shape == (4096, 8192)
+        and moe.pre_expert_proj.weight.dtype == torch.bfloat16
+        and moe.pre_expert_proj.weight.is_contiguous()
+        and moe.pre_expert_norm is not None
+        and moe.pre_expert_norm.weight is not None
+        and op.router_score_normalization == "sigmoid"
+        and op.num_valid_tokens is None
+        and op.local_expert_mapping is None
+        and op.sol_topk_out is None
+    )
+
+
+def route_with_shared_pooler(moe, x: torch.Tensor):
+    """(top-8 scores, expert ids, normalized expert input) for ``x``; requires ``can_share_router_pooler``."""
+    m = x.shape[0]
+    norm_weight = moe.pre_expert_norm._get_effective_weight()
+    if JOINT_ROUTER_POOLER and m in _JOINT_ROWS:
+        packed = moe.router_pooler_packed_weight
+        assert moe.pre_expert_proj.weight.data_ptr() == packed.data_ptr()
+        key = ("joint", moe.layer_idx, m)
+        if key not in _logged:
+            _logged.add(key)
+            logger.info(
+                "Muse joint router/pooler active: layer=%d rows=%d", moe.layer_idx, m
+            )
+        return joint_router_pooler_topk(
+            x,
+            packed,
+            moe.expert_bias,
+            norm_weight,
+            float(moe.router_multiplier),
+            float(moe.route_scale),
+            float(moe.pre_expert_norm.eps),
+        )
+    key = "shared" if m <= 16 else "shared_completed"
+    if key not in _logged:
+        _logged.add(key)
+        logger.info(
+            "Muse fast path: %s, rows=%d",
+            (
+                "shared router/preproject epilogue"
+                if m <= 16
+                else "shared router/norm with hipBLASLt pooler"
+            ),
+            m,
+        )
+    return router_pooler_topk(
+        x,
+        moe.router.weight,
+        moe.pre_expert_proj.weight,
+        moe.expert_bias,
+        norm_weight,
+        float(moe.router_multiplier),
+        float(moe.route_scale),
+        float(moe.pre_expert_norm.eps),
+        pooler_tiled=getattr(moe.pre_expert_proj, "small_m_tiled_weight", None),
+    )
+
+
+@torch.no_grad()
+def prepare_joint_router_pooler(moe) -> None:
+    """Pack ``[pooler; router high; router low]`` once after loading; the pooler weight aliases the prefix."""
+    router, pooler = moe.router.weight, moe.pre_expert_proj.weight
+    assert router.is_cuda and pooler.is_cuda
+    assert router.shape == (8192, 256) and router.dtype == torch.float32
+    assert pooler.shape == (4096, 8192) and pooler.dtype == torch.bfloat16
+    packed = getattr(moe, "router_pooler_packed_weight", None)
+    if packed is None:
+        # Runs in post_load_weights, before warmup or graph capture. The pooler prefix holds exactly the
+        # original BF16 values and stays available to the plain nn.Linear path at larger M.
+        packed = pack_joint_router_pooler_weight(router, pooler)
+        pooler.data = packed[:4096]
+        moe.register_buffer("router_pooler_packed_weight", packed, persistent=False)
+    else:
+        # Later checkpoint writes already land in the aliased prefix; refresh only the router parts,
+        # without moving any captured addresses.
+        assert pooler.data_ptr() == packed.data_ptr()
+        high = router.T.to(torch.bfloat16)
+        packed[4096:4352].copy_(high)
+        packed[4352:].copy_((router.T - high.float()).to(torch.bfloat16))
+    assert pooler.is_contiguous() and pooler.data_ptr() == packed.data_ptr()
--- v1/sgl-workspace/sglang/python/sglang/kernels/ops/attention/qk_norm_rope_cache.py
+++ v2/sgl-workspace/sglang/python/sglang/kernels/ops/attention/qk_norm_rope_cache.py
@@ -0,0 +1,290 @@
+"""Per-head QK RMSNorm + interleaved RoPE + paged FP8 KV-cache store (Muse Spark, head_dim 64, page 16).
+
+* ``qk_norm_rope_cache``: from projected Q/K/V. One program per (token, Q head) normalizes, scales and rotates
+  Q; the first Q head of each GQA group also normalizes and rotates its K and stores K/V into the FP8 cache
+  (optionally through the full -> SWA slot mapping).
+* ``qkv_proj_qk_norm_rope_cache``: the same epilogue fed straight from the BF16 split-K partials of the fused
+  QKV + output-gate projection (``bf16_splitk_gemm``), which also emits V and the gate.
+
+The BF16 round trips of the unfused sequence (norm output, query scaling, RoPE products, projection store)
+are explicit, so the results match the separate norm / RoPE / cache-write kernels.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.kernels.ops.gemm.bf16_splitk_gemm import bf16_splitk_gemm_partials
+
+
+@triton.jit
+def _norm_rope(
+    x,
+    COS,
+    POS,
+    eps,
+    scale,
+    D: tl.constexpr,
+    ROPE: tl.constexpr,
+    Q_SCALE: tl.constexpr,
+    COS_STRIDE: tl.constexpr,
+):
+    d = tl.arange(0, D)
+    f = x.to(tl.float32)
+    inv = tl.rsqrt(tl.sum(f * f, axis=0) / D + eps)
+    value = (f * inv).to(tl.bfloat16).to(tl.float32)
+    if Q_SCALE:
+        value = (value * scale).to(tl.bfloat16).to(tl.float32)
+    if ROPE:
+        pos = tl.load(POS + tl.program_id(0))
+        # Day0 pos_enc.cu stores the FP32 cache loads in scalar_t (BF16),
+        # and its BF16 operators round both products before the final add.
+        cosine = tl.load(COS + pos * COS_STRIDE + d // 2).to(tl.bfloat16).to(tl.float32)
+        sine = (
+            tl.load(COS + pos * COS_STRIDE + D // 2 + d // 2)
+            .to(tl.bfloat16)
+            .to(tl.float32)
+        )
+        other = tl.reshape(tl.flip(tl.reshape(value, (D // 2, 2)), 1), (D,))
+        rotated = tl.where(d % 2 == 0, -other, other)
+        first = (value * cosine).to(tl.bfloat16).to(tl.float32)
+        second = (rotated * sine).to(tl.bfloat16).to(tl.float32)
+        value = first + second
+    return value.to(tl.bfloat16)
+
+
+@triton.jit
+def _muse_qk_rope_cache(
+    Q,
+    K,
+    V,
+    POS,
+    COS,
+    LOC,
+    MAP,
+    KC,
+    VC,
+    QO,
+    KO,
+    KS,
+    VS,
+    QS: tl.constexpr,
+    KSTR: tl.constexpr,
+    VSTR: tl.constexpr,
+    HQ: tl.constexpr,
+    HK: tl.constexpr,
+    D: tl.constexpr,
+    EPS: tl.constexpr,
+    SCALE: tl.constexpr,
+    ROPE: tl.constexpr,
+    HAS_MAP: tl.constexpr,
+    HAS_SCALE: tl.constexpr,
+    COS_STRIDE: tl.constexpr,
+):
+    token, head = tl.program_id(0), tl.program_id(1)
+    d = tl.arange(0, D)
+    q = tl.load(Q + token * QS + head * D + d)
+    q = _norm_rope(q, COS, POS, EPS, SCALE, D, ROPE, True, COS_STRIDE)
+    tl.store(QO + token * HQ * D + head * D + d, q)
+    if head % (HQ // HK) == 0:
+        kh = head // (HQ // HK)
+        k = tl.load(K + token * KSTR + kh * D + d)
+        k = _norm_rope(k, COS, POS, EPS, 1.0, D, ROPE, False, COS_STRIDE)
+        tl.store(KO + token * HK * D + kh * D + d, k)
+        slot = tl.load(LOC + token).to(tl.int64)
+        if slot >= 0:
+            if HAS_MAP:
+                slot = tl.load(MAP + slot).to(tl.int64)
+            if slot >= 0:
+                v = tl.load(V + token * VSTR + kh * D + d)
+                if HAS_SCALE:
+                    k_value = k.to(tl.float32) / tl.load(KS)
+                    v_value = v.to(tl.float32) / tl.load(VS)
+                else:
+                    k_value = k.to(tl.float32)
+                    v_value = v.to(tl.float32)
+                offset = slot * HK * D + kh * D + d
+                tl.store(KC + offset, k_value)
+                tl.store(VC + offset, v_value)
+
+
+@triton.jit
+def _project_slice(
+    P, TOKEN, FIRST, M: tl.constexpr, N: tl.constexpr, SK: tl.constexpr, D: tl.constexpr
+):
+    split = tl.arange(0, SK)
+    col = FIRST + tl.arange(0, D)
+    partial = tl.load(P + split[:, None] * M * N + TOKEN * N + col[None, :])
+    return tl.sum(partial, axis=0).to(tl.bfloat16)
+
+
+@triton.jit
+def _qkv_epilogue(
+    P,
+    POS,
+    COS,
+    LOC,
+    MAP,
+    KC,
+    VC,
+    QO,
+    KO,
+    VO,
+    GO,
+    KS,
+    VS,
+    M: tl.constexpr,
+    N: tl.constexpr,
+    SK: tl.constexpr,
+    HQ: tl.constexpr,
+    HK: tl.constexpr,
+    D: tl.constexpr,
+    EPS: tl.constexpr,
+    SCALE: tl.constexpr,
+    ROPE: tl.constexpr,
+    HAS_MAP: tl.constexpr,
+    COS_STRIDE: tl.constexpr,
+):
+    token, head = tl.program_id(0), tl.program_id(1)
+    d = tl.arange(0, D)
+    gate = _project_slice(P, token, (HQ + 2 * HK) * D + head * D, M, N, SK, D)
+    tl.store(GO + token * HQ * D + head * D + d, gate)
+    q = _project_slice(P, token, head * D, M, N, SK, D)
+    q = _norm_rope(q, COS, POS, EPS, SCALE, D, ROPE, True, COS_STRIDE)
+    tl.store(QO + token * HQ * D + head * D + d, q)
+    if head % (HQ // HK) == 0:
+        kh = head // (HQ // HK)
+        k = _project_slice(P, token, HQ * D + kh * D, M, N, SK, D)
+        v = _project_slice(P, token, (HQ + HK) * D + kh * D, M, N, SK, D)
+        k = _norm_rope(k, COS, POS, EPS, 1.0, D, ROPE, False, COS_STRIDE)
+        tl.store(KO + token * HK * D + kh * D + d, k)
+        tl.store(VO + token * HK * D + kh * D + d, v)
+        slot = tl.load(LOC + token).to(tl.int64)
+        if slot >= 0:
+            if HAS_MAP:
+                slot = tl.load(MAP + slot).to(tl.int64)
+            if slot >= 0:
+                offset = slot * HK * D + kh * D + d
+                tl.store(KC + offset, k.to(tl.float32) / tl.load(KS))
+                tl.store(VC + offset, v.to(tl.float32) / tl.load(VS))
+
+
+def qk_norm_rope_cache(
+    q,
+    k,
+    v,
+    positions,
+    cos_sin,
+    cache_k,
+    cache_v,
+    locations,
+    swa_mapping,
+    eps,
+    q_scale,
+    k_scale,
+    v_scale,
+    warps=1,
+    fp_fusion=True,
+):
+    """Return (normalized + rotated Q [M, HQ*64], K [M, HK*64]); K/V of each token go to the FP8 cache."""
+    m = q.shape[0]
+    d = 64
+    hq = q.shape[1] // d
+    hk = k.shape[1] // d
+    assert q.dtype == k.dtype == v.dtype == torch.bfloat16
+    assert cache_k.dtype == cache_v.dtype == torch.float8_e4m3fn
+    assert cache_k.is_contiguous() and cache_v.is_contiguous()
+    assert q.shape == (m, hq * d) and k.shape == v.shape == (m, hk * d)
+    qo = torch.empty_like(q, memory_format=torch.contiguous_format)
+    ko = torch.empty_like(k, memory_format=torch.contiguous_format)
+    if m:
+        _muse_qk_rope_cache[(m, hq)](
+            q,
+            k,
+            v,
+            positions,
+            cos_sin,
+            locations,
+            swa_mapping,
+            cache_k,
+            cache_v,
+            qo,
+            ko,
+            k_scale,
+            v_scale,
+            q.stride(0),
+            k.stride(0),
+            v.stride(0),
+            hq,
+            hk,
+            d,
+            float(eps),
+            float(q_scale),
+            cos_sin is not None,
+            swa_mapping is not None,
+            k_scale is not None,
+            cos_sin.stride(0) if cos_sin is not None else d,
+            num_warps=warps,
+            enable_fp_fusion=fp_fusion,
+        )
+    return qo, ko
+
+
+def qkv_proj_qk_norm_rope_cache(
+    x,
+    weight,
+    positions,
+    cos_sin,
+    cache_k,
+    cache_v,
+    locations,
+    mapping,
